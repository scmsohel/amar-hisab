# Copy to .env on the Proxmox host and replace every placeholder.
POSTGRES_DB=amarhisab
POSTGRES_USER=amarhisab_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_SETUP_KEY=REPLACE_WITH_A_LONG_RANDOM_SETUP_KEY
ADMIN_NAME=Amar Hisab Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_PASSWORD_AT_LEAST_12_CHARACTERS
COOKIE_SECURE=false

# Brevo SMTP: use SMTP login and SMTP key (not API key)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
SMTP_FROM=Amar Hisab <noreply@schome.my.id>
